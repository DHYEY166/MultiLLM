# MultiLLM Environment Configuration
# Copy this file to .env and update with your values
# SECURITY WARNING: Never commit .env file to git!

# Server Configuration
PORT=8000
NODE_ENV=production

# Session Configuration
# CRITICAL: Generate a secure random secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT use the example value in production!
SESSION_SECRET=your-super-secret-session-key-here-CHANGE-THIS-IN-PRODUCTION

# Authentication Configuration
# SECURITY: These should only be set in production environment
# Leave blank if not using Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration (optional - defaults to local file storage)
USER_DATA_FILE=./data/users.json

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Security Configuration
# Set to 'true' in production for HTTPS-only cookies
SECURE_COOKIES=true

# Redis Configuration (optional - for session storage)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# SECURITY CHECKLIST:
# 1. Generate strong SESSION_SECRET (32+ random characters)
# 2. Never expose Google OAuth secrets in logs or version control
# 3. Use HTTPS in production (for secure cookies)
# 4. Regularly rotate secrets
# 5. Backup users.json file
# 6. Monitor security logs for suspicious activity